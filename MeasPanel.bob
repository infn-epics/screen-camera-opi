    <y use_class="true">0</y>
    <width>340</width>
    <height>31</height>
    <font use_class="true">
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <foreground_color use_class="true">
      <color name="Text" red="0" green="0" blue="0">
      </color>
    </foreground_color>
    <transparent use_class="true">true</transparent>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Section_ROI</name>
    <text>Region of Interest</text>
    <x>12</x>
    <y>38</y>
    <width>316</width>
    <height>18</height>
    <font>
      <font name="Header 2" family="Liberation Sans" style="BOLD" size="14.0">
      </font>
    </font>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group_ROI</name>
    <x>12</x>
    <y>58</y>
    <width>316</width>
    <height>128</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="action_button" version="3.0.0">
      <name>ApplyROI</name>
      <actions>
        <action type="execute">
          <description>Apply drawn ROI to camera acquisition region</description>
          <script file="EmbeddedPy">
            <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

x = int(PVUtil.getDouble(pvs[0]))
y = int(PVUtil.getDouble(pvs[1]))
w = int(PVUtil.getDouble(pvs[2]))
h = int(PVUtil.getDouble(pvs[3]))

pvs[4].write(x)
pvs[5].write(y)
pvs[6].write(w)
pvs[7].write(h)]]></text>
            <pv_name>loc://roi_x</pv_name>
            <pv_name>loc://roi_y</pv_name>
            <pv_name>loc://roi_w</pv_name>
            <pv_name>loc://roi_h</pv_name>
            <pv_name>$(DEVICE):$(CAM):MinX</pv_name>
            <pv_name>$(DEVICE):$(CAM):MinY</pv_name>
            <pv_name>$(DEVICE):$(CAM):SizeX</pv_name>
            <pv_name>$(DEVICE):$(CAM):SizeY</pv_name>
          </script>
        </action>
      </actions>
      <text>Apply ROI to Camera</text>
      <x>0</x>
      <y>0</y>
      <width>316</width>
      <height>32</height>
      <font>
        <font name="Header 2" family="Liberation Sans" style="BOLD" size="16.0">
        </font>
      </font>
      <foreground_color>
        <color name="IO Foreground" red="0" green="0" blue="0">
        </color>
      </foreground_color>
      <tooltip>Push the on-image ROI (x/y/w/h) to $(DEVICE):$(CAM):MinX/MinY/SizeX/SizeY</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>ResetROI</name>
      <actions>
        <action type="execute">
          <description>Reset camera acquisition region to full sensor size</description>
          <script file="EmbeddedPy">
            <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

max_x = int(PVUtil.getDouble(pvs[0]))
max_y = int(PVUtil.getDouble(pvs[1]))

pvs[2].write(0)
pvs[3].write(0)
pvs[4].write(max_x)
pvs[5].write(max_y)

pvs[6].write(0)
pvs[7].write(0)
pvs[8].write(max_x)
pvs[9].write(max_y)]]></text>
            <pv_name>$(DEVICE):$(CAM):MaxSizeX_RBV</pv_name>
            <pv_name>$(DEVICE):$(CAM):MaxSizeY_RBV</pv_name>
            <pv_name>$(DEVICE):$(CAM):MinX</pv_name>
            <pv_name>$(DEVICE):$(CAM):MinY</pv_name>
            <pv_name>$(DEVICE):$(CAM):SizeX</pv_name>
            <pv_name>$(DEVICE):$(CAM):SizeY</pv_name>
            <pv_name>loc://roi_x</pv_name>
            <pv_name>loc://roi_y</pv_name>
            <pv_name>loc://roi_w</pv_name>
            <pv_name>loc://roi_h</pv_name>
          </script>
        </action>
      </actions>
      <text>Reset ROI to Full Frame</text>
      <x>0</x>
      <y>38</y>
      <width>316</width>
      <height>32</height>
      <font>
        <font name="Header 2" family="Liberation Sans" style="BOLD" size="16.0">
        </font>
      </font>
      <foreground_color>
        <color name="IO Foreground" red="0" green="0" blue="0">
        </color>
      </foreground_color>
      <tooltip>Set MinX/MinY to 0 and SizeX/SizeY to the full sensor size</tooltip>
    </widget>
