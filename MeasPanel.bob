    <height>18</height>
    <horizontal_alignment>2</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
    <scripts>
      <script file="Scripts/GetPixelInfo.py">
        <pv_name>loc://cursor_info</pv_name>
      </script>
    </scripts>
  </widget>
  <widget type="image" version="2.0.0">
    <name>CameraImage</name>
    <pv_name>pva://$(DEVICE):$(CAM):$(PLUGIN_IMG):OUTPUT</pv_name>
    <x>12</x>
    <y>58</y>
    <width>316</width>
    <height>260</height>
    <show_toolbar>true</show_toolbar>
    <rules>
      <rule name="interactive" prop_id="rois[0].interactive" out_exp="false">
        <exp bool_exp="pv0&lt;1">
          <value>false</value>
        </exp>
        <pv_name>loc://roi_interactive(1)</pv_name>
      </rule>
      <rule name="centroidBoxVisible" prop_id="rois[1].visible" out_exp="false">
        <exp bool_exp="pv0&lt;1">
          <value>false</value>
        </exp>
        <pv_name>$(DEVICE):$(CAM):$(PLUGIN_R)Stats1:ComputeCentroid_RBV</pv_name>
      </rule>
    </rules>
    <limits_from_pv>true</limits_from_pv>
    <unsigned>true</unsigned>
    <cursor_info_pv>loc://cursor_info</cursor_info_pv>
    <x_pv>loc://cursor_x</x_pv>
    <y_pv>loc://cursor_y</y_pv>
    <rois>
      <roi>
        <name>imageROI</name>
        <color>
          <color red="255" green="168" blue="0">
          </color>
        </color>
        <visible>false</visible>
        <interactive>false</interactive>
        <x_pv>loc://roi_x(20)</x_pv>
        <y_pv>loc://roi_y(20)</y_pv>
        <width_pv>loc://roi_w(100)</width_pv>
        <height_pv>loc://roi_h(100)</height_pv>
        <file></file>
      </roi>
      <roi>
        <name>CentroidBox</name>
        <color>
          <color red="0" green="255" blue="255">
          </color>
        </color>
        <visible>true</visible>
        <interactive>true</interactive>
        <x_pv>$(DEVICE):$(CAM):$(PLUGIN_R)Stats1:CentroidX_RBV</x_pv>
        <y_pv>$(DEVICE):$(CAM):$(PLUGIN_R)Stats1:CentroidY_RBV</y_pv>
        <width_pv>$(DEVICE):$(CAM):$(PLUGIN_R)Stats1:SigmaX_RBV</width_pv>
        <height_pv>$(DEVICE):$(CAM):$(PLUGIN_R)Stats1:SigmaY_RBV</height_pv>
        <file></file>
      </roi>
    </rois>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Section_ROI</name>
    <text>Region of Interest</text>
    <x>12</x>
    <y>333</y>
    <width>316</width>
    <height>18</height>
    <font>
      <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
      </font>
    </font>
  </widget>
  <widget type="group" version="3.0.0">
    <name>Group_ROI</name>
    <x>12</x>
    <y>353</y>
    <width>316</width>
    <height>128</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="action_button" version="3.0.0">
      <name>ApplyROI</name>
      <actions>
        <action type="execute">
          <description>Apply drawn ROI to camera acquisition region</description>
          <script file="EmbeddedPy">
            <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

mydev = widget.getEffectiveMacros().getValue("DEVICE")
mycam = widget.getEffectiveMacros().getValue("CAM")
plugin_r = widget.getEffectiveMacros().getValue("PLUGIN_R")
if plugin_r is None:
    plugin_r = ""
prefx = mydev + ":" + mycam + ":"

roi_x = PVUtil.createPV("loc://roi_x", 1000)
roi_y = PVUtil.createPV("loc://roi_y", 1000)
roi_w = PVUtil.createPV("loc://roi_w", 1000)
roi_h = PVUtil.createPV("loc://roi_h", 1000)

x = int(PVUtil.getDouble(roi_x))
y = int(PVUtil.getDouble(roi_y))
w = int(PVUtil.getDouble(roi_w))
h = int(PVUtil.getDouble(roi_h))

if plugin_r == "":
    # Raw view: crop the camera's own acquisition window.
    min_x = PVUtil.createPV(prefx + "MinX", 1000)
    min_y = PVUtil.createPV(prefx + "MinY", 1000)
    size_x = PVUtil.createPV(prefx + "SizeX", 1000)
    size_y = PVUtil.createPV(prefx + "SizeY", 1000)

    # Min to 0 first so the new size below is never rejected by the old,
    # possibly incompatible, Min/Size combination on the camera.
    min_x.write(0)
    min_y.write(0)
    size_x.write(w)
    size_y.write(h)
    min_x.write(x)
    min_y.write(y)

    # The ROI1 plugin may not be provisioned for this camera - don't let a
    # missing/disconnected plugin block the camera acquisition region above.
    try:
        roi_min_x = PVUtil.createPV(prefx + "Roi1:MinX", 1000)
        roi_min_y = PVUtil.createPV(prefx + "Roi1:MinY", 1000)
        roi_size_x = PVUtil.createPV(prefx + "Roi1:SizeX", 1000)
        roi_size_y = PVUtil.createPV(prefx + "Roi1:SizeY", 1000)

        roi_min_x.write(0)
        roi_min_y.write(0)
        roi_size_x.write(w)
        roi_size_y.write(h)
        roi_min_x.write(x)
        roi_min_y.write(y)
    except:
        ScriptUtil.getLogger().warning("ROI1 plugin not available on " + prefx + ", skipped Roi1:Min/Size")
else:
    # Viewing a downstream plugin output (e.g. ROI1) - set that plugin's
    # own region instead of the base camera acquisition window, which
    # isn't what defines this view and may not even be reachable.
    try:
        plugin_min_x = PVUtil.createPV(prefx + plugin_r + "MinX", 1000)
        plugin_min_y = PVUtil.createPV(prefx + plugin_r + "MinY", 1000)
        plugin_size_x = PVUtil.createPV(prefx + plugin_r + "SizeX", 1000)
        plugin_size_y = PVUtil.createPV(prefx + plugin_r + "SizeY", 1000)

        plugin_min_x.write(0)
        plugin_min_y.write(0)
        plugin_size_x.write(w)
        plugin_size_y.write(h)
        plugin_min_x.write(x)
        plugin_min_y.write(y)
    except:
        ScriptUtil.getLogger().warning(prefx + plugin_r + " has no MinX/MinY/SizeX/SizeY (plugin not provisioned or doesn't support a region)")]]></text>
          </script>
        </action>
      </actions>
      <text>Apply ROI to Camera</text>
      <width>316</width>
      <height>32</height>
      <font>
        <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
        </font>
      </font>
      <foreground_color>
        <color name="IO Foreground" red="0" green="0" blue="0">
        </color>
      </foreground_color>
      <tooltip>Raw view: push ROI (x/y/w/h) to the camera's MinX/MinY/SizeX/SizeY (and Roi1: if present). Plugin view (e.g. ROI1): push to that plugin's own MinX/MinY/SizeX/SizeY instead.</tooltip>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>ResetROI</name>
      <actions>
        <action type="execute">
          <description>Reset camera acquisition region to full sensor size</description>
          <script file="EmbeddedPy">
            <text><![CDATA[# Embedded python script
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil

mydev = widget.getEffectiveMacros().getValue("DEVICE")
mycam = widget.getEffectiveMacros().getValue("CAM")
plugin_r = widget.getEffectiveMacros().getValue("PLUGIN_R")
if plugin_r is None:
    plugin_r = ""
prefx = mydev + ":" + mycam + ":"

# 100000 is far above any sensor size, so the IOC clamps it down to
# MaxSizeX/MaxSizeY automatically - no need to read the max first.
if plugin_r == "":
    min_x = PVUtil.createPV(prefx + "MinX", 1000)
    min_y = PVUtil.createPV(prefx + "MinY", 1000)
    size_x = PVUtil.createPV(prefx + "SizeX", 1000)
    size_y = PVUtil.createPV(prefx + "SizeY", 1000)

    min_x.write(0)
    min_y.write(0)
    size_x.write(100000)
    size_y.write(100000)

    # The ROI1 plugin may not be provisioned for this camera - don't let a
    # missing/disconnected plugin block the camera acquisition region above.
    try:
        roi_min_x = PVUtil.createPV(prefx + "Roi1:MinX", 1000)
        roi_min_y = PVUtil.createPV(prefx + "Roi1:MinY", 1000)
        roi_size_x = PVUtil.createPV(prefx + "Roi1:SizeX", 1000)
        roi_size_y = PVUtil.createPV(prefx + "Roi1:SizeY", 1000)

        roi_min_x.write(0)
        roi_min_y.write(0)
        roi_size_x.write(100000)
        roi_size_y.write(100000)
    except:
        ScriptUtil.getLogger().warning("ROI1 plugin not available on " + prefx + ", skipped Roi1:Min/Size")
else:
    # Viewing a downstream plugin output - reset that plugin's own region.
    try:
        plugin_min_x = PVUtil.createPV(prefx + plugin_r + "MinX", 1000)
        plugin_min_y = PVUtil.createPV(prefx + plugin_r + "MinY", 1000)
        plugin_size_x = PVUtil.createPV(prefx + plugin_r + "SizeX", 1000)
        plugin_size_y = PVUtil.createPV(prefx + plugin_r + "SizeY", 1000)

        plugin_min_x.write(0)
        plugin_min_y.write(0)
        plugin_size_x.write(100000)
        plugin_size_y.write(100000)
    except:
        ScriptUtil.getLogger().warning(prefx + plugin_r + " has no MinX/MinY/SizeX/SizeY (plugin not provisioned or doesn't support a region)")
]]></text>
          </script>
        </action>
      </actions>
      <text>Reset ROI to Full Frame</text>
      <y>38</y>
      <width>316</width>
      <height>32</height>
      <font>
        <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
        </font>
      </font>
      <foreground_color>
        <color name="IO Foreground" red="0" green="0" blue="0">
        </color>
      </foreground_color>
      <tooltip>Raw view: reset the camera's (and Roi1:'s, if present) MinX/MinY to 0 and SizeX/SizeY to full size. Plugin view: reset that plugin's own region instead.</tooltip>
    </widget>
